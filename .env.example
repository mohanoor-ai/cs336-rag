# LLM provider: "opencode" (DeepSeek V4 Flash) or "openai" (GPT-4o-mini)
LLM_PROVIDER=opencode

# Add your API key for the provider you chose:
OPENCODE_API_KEY=your-key-here
# OPENAI_API_KEY=your-openai-key-here

# Optional overrides (defaults depend on LLM_PROVIDER):
# LLM_MODEL=deepseek-v4-flash
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
